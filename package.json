{
  "name": "self-website",
  "version": "1.0.0",
  "private": true,
  "source": "src/index.html",
  "scripts": {
    "dev": "parcel src/index.html --port 3000 --open",
    "build": "parcel build src/index.html --dist-dir dist",
    "predeploy": "parcel build src/index.html --dist-dir dist --public-url /",
    "deploy": "gh-pages -d dist",
    "clean": "rimraf dist .parcel-cache"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.22.3"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "gh-pages": "^6.3.0",
    "parcel": "^2.13.3",
    "process": "^0.11.10",
    "typescript": "^5.7.2"
  }
}
